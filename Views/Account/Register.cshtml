@model RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<h1>Регистрация</h1>

<form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="task-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Пароль</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Повторите пароль</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Зарегистрироваться</button>
    <a class="btn btn-secondary" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Вход</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
