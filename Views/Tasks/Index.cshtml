@model TodoTaskIndexViewModel

@{
    ViewData["Title"] = "Все задачи";
    string userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

<h1>Список задач</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form asp-action="Index" method="get" class="filter-form">
    <div>
        <label class="form-label" for="title">Заголовок</label>
        <input class="form-control" id="title" name="title" value="@Model.Filter.Title" placeholder="Поиск по названию" />
    </div>
    <div>
        <label class="form-label" for="descriptionWords">Слова в описании</label>
        <input class="form-control" id="descriptionWords" name="descriptionWords" value="@Model.Filter.DescriptionWords" placeholder="Поиск по описанию" />
    </div>
    <div>
        <label class="form-label" for="createdFrom">Дата создания от</label>
        <input class="form-control" id="createdFrom" name="createdFrom" type="date" value="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label" for="createdTo">Дата создания до</label>
        <input class="form-control" id="createdTo" name="createdTo" type="date" value="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label" for="priority">Приоритет</label>
        <select class="form-select" id="priority" name="priority">
            <option value="">Все приоритеты</option>
            @foreach (TodoPriority priority in Enum.GetValues<TodoPriority>())
            {
                <option value="@priority" selected="@(Model.Filter.Priority == priority)">@priority.ToDisplayName()</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label" for="status">Состояние</label>
        <select class="form-select" id="status" name="status">
            <option value="">Все состояния</option>
            @foreach (TodoStatus status in Enum.GetValues<TodoStatus>())
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@status.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button class="btn btn-primary" type="submit">Фильтровать</button>
        <a class="btn btn-secondary" asp-action="Index">Сбросить</a>
    </div>
</form>

<p>
    <a class="btn btn-success" asp-action="Create">Добавить задачу</a>
</p>

@if (!Model.Tasks.Any())
{
    <div class="alert alert-warning">Задачи не найдены.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Номер</th>
                <th>
                    <a asp-action="Index"
                       asp-route-title="@Model.Filter.Title"
                       asp-route-descriptionWords="@Model.Filter.DescriptionWords"
                       asp-route-createdFrom="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")"
                       asp-route-createdTo="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")"
                       asp-route-priority="@Model.Filter.Priority"
                       asp-route-status="@Model.Filter.Status"
                       asp-route-sortBy="title"
                       asp-route-sortDirection="@Model.NextDirectionFor("title")">Название</a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-title="@Model.Filter.Title"
                       asp-route-descriptionWords="@Model.Filter.DescriptionWords"
                       asp-route-createdFrom="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")"
                       asp-route-createdTo="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")"
                       asp-route-priority="@Model.Filter.Priority"
                       asp-route-status="@Model.Filter.Status"
                       asp-route-sortBy="priority"
                       asp-route-sortDirection="@Model.NextDirectionFor("priority")">Приоритет</a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-title="@Model.Filter.Title"
                       asp-route-descriptionWords="@Model.Filter.DescriptionWords"
                       asp-route-createdFrom="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")"
                       asp-route-createdTo="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")"
                       asp-route-priority="@Model.Filter.Priority"
                       asp-route-status="@Model.Filter.Status"
                       asp-route-sortBy="status"
                       asp-route-sortDirection="@Model.NextDirectionFor("status")">Статус</a>
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-title="@Model.Filter.Title"
                       asp-route-descriptionWords="@Model.Filter.DescriptionWords"
                       asp-route-createdFrom="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")"
                       asp-route-createdTo="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")"
                       asp-route-priority="@Model.Filter.Priority"
                       asp-route-status="@Model.Filter.Status"
                       asp-route-sortBy="created"
                       asp-route-sortDirection="@Model.NextDirectionFor("created")">Дата создания</a>
                </th>
                <th>Создатель</th>
                <th>Исполнитель</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        @foreach (TodoTask task in Model.Tasks)
        {
            <tr>
                <td>@task.Id</td>
                <td>@task.Title</td>
                <td><span class="@task.Priority.ToCssClass()">@task.Priority.ToDisplayName()</span></td>
                <td>@task.Status.ToDisplayName()</td>
                <td>@task.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@task.CreatorName</td>
                <td>@(task.AssigneeName ?? "Свободна")</td>
                <td class="task-actions">
                    @if (task.Status == TodoStatus.New && string.IsNullOrWhiteSpace(task.AssigneeId))
                    {
                        <form asp-action="Take" method="post">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Взять задачу</button>
                        </form>
                    }
                    @if (task.Status == TodoStatus.Open && (User.IsInRole("admin") || task.AssigneeId == userId))
                    {
                        <form asp-action="Close" method="post">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button class="btn btn-sm btn-outline-warning" type="submit">Закрыть</button>
                        </form>
                    }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@task.Id">Детали</a>
                    @if (User.IsInRole("admin") || task.CreatorId == userId)
                    {
                        <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@task.Id">Изменить</a>
                    }
                    @if (User.IsInRole("admin") || task.CreatorId == userId)
                    {
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Удалить</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav aria-label="Страницы списка задач">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-title="@Model.Filter.Title"
                   asp-route-descriptionWords="@Model.Filter.DescriptionWords"
                   asp-route-createdFrom="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")"
                   asp-route-createdTo="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")"
                   asp-route-priority="@Model.Filter.Priority"
                   asp-route-status="@Model.Filter.Status"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-page="@(Model.Page - 1)">Предыдущая</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Model.Page из @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-title="@Model.Filter.Title"
                   asp-route-descriptionWords="@Model.Filter.DescriptionWords"
                   asp-route-createdFrom="@Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd")"
                   asp-route-createdTo="@Model.Filter.CreatedTo?.ToString("yyyy-MM-dd")"
                   asp-route-priority="@Model.Filter.Priority"
                   asp-route-status="@Model.Filter.Status"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   asp-route-page="@(Model.Page + 1)">Следующая</a>
            </li>
        </ul>
    </nav>
}
